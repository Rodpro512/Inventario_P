@model VistaConTablasViewModel
@using System.Linq

@{
    ViewData["Title"] = "Tu Vista";
}

<body style="background: url('https://media.gettyimages.com/id/1469875556/es/v%C3%ADdeo/fondo-de-l%C3%ADneas-abstractas-4k-loopable.jpg?s=640x640&k=20&c=VKM-5Fe6vYWW_fp_ZkqOwYLPnszs47JP6UJoMSSO2IQ=') no-repeat center center/cover">
    <!-- Header -->
    <header>
        <nav class="navbar navbar-expand-lg" style="background-color: #280336;">
            <div class="container-fluid">
                <!-- Logo -->
                <a class="navbar-brand" href="index.php">
                    <img src="~/Imagenes/Logo NeoMarket.png" alt="Logo" width="100" height="100" class="d-inline-block align-text-top">
                </a>

                <!-- Botón hamburguesa -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <div class="btn-group" role="group" aria-label="Basic example">
                            <a href="~/Informativo/Index"><button type="button" class="btn btn-primary">Inicio</button></a>

                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Movimiento de Productos
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="~/Ingreso/Index">Ingreso de Productos</a></li>
                                    <li><a class="dropdown-item" href="~/Egreso/Index">Egreso de Productos</a></li>
                                </ul>
                            </div>
                            <a href="/Stock/Index"><button type="button" class="btn btn-primary">Stock y Tablas</button></a>
                            <a href="~/Home/Index"><button type="button" class="btn btn-primary">Cerrar Sesion</button></a>
                        </div>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <br>
    <br>
    <br>

    <!--Visualizacion de las Tablas-->
    <div class="card">
        <h5 class="card-header text-white" style="background-color: #141322;">Featured</h5>
        <div class="card-body" style="background-color: #a9a105;">
            <h5 class="card-title text-white"><strong>Stock y Tablas</strong></h5>
            <p class="card-text text-white">Seleccione la Tabla que desea ver</p>
          <form method="post">
            <select class="form-select" name="tablaSeleccionada" required>
                <option selected>...</option>
                <option value="Producto">Productos</option>
                <option value="Bitacora">Bitacora</option>
                <option value="MovimientoDeProducto">Movimientos</option>
            </select>
            <br>
            <!-- Button trigger modal -->
            <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-dark" data-bs-target="#tablaModal">
                    Mostrar tabla
                </button>
            </div>
            </form>
        </div>
    </div>

    <!-- Modal de la seleccion de tablas-->
    <div class="modal fade" id="tablaModal" tabindex="-1" aria-labelledby="tablaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" style="background-color: #f5f5dc;">
                <div class="modal-header">
                    <h5 class="modal-title" id="tablaModalLabel">Datos de @Model?.tablaSeleccionada</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">

                    @if (Model?.tablaSeleccionada == "Producto" && Model?.ProductoData != null && Model.ProductoData.Any())
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.ProductoData ?? Enumerable.Empty<Inventario_P.Models.Producto>())
                                {
                                    <tr>
                                        <td>@p.IdProducto</td>
                                        <td>@p.Nombre</td>
                                        <td>@p.Codigo</td>
                                        <td>@p.IdMarca</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (Model?.tablaSeleccionada == "Bitacora" && Model?.BitacoraData != null && Model.BitacoraData.Any())
                    {
                        <table class="table">
                            <thead><tr><th>ID</th><th>Acción</th><th>Fecha</th></tr></thead>
                            <tbody>
                                @foreach (var b in Model.BitacoraData ?? Enumerable.Empty<Inventario_P.Models.Bitacora>())
                                {
                                    <tr><td>@b.IdLogin</td>
                                        <td>@b.Accion</td>
                                        <td>@b.Fecha</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (Model?.tablaSeleccionada == "MovimientoDeProducto" && Model?.MovimientoDeProductoData != null && Model.MovimientoDeProductoData.Any())
                    {
                        <table class="table">
                            <thead><tr><th>ID</th><th>Producto</th><th>Cantidad</th><th>Tipo</th><th>Fecha</th></tr></thead>
                            <tbody>
                                @foreach (var m in Model.MovimientoDeProductoData ?? Enumerable.Empty<Inventario_P.Models.MovimientoDeProducto>())
                                {
                                    <tr><td>@m.IdMoviento</td><td>@m.IdProducto</td><td>@m.Cantidad</td><td>@m.Tipo</td><td>@m.Fecha</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No hay datos para mostrar.</p>
                    }

                </div>
            </div>
        </div>
    </div>



    <!-- Footer -->
    <footer class=" text-white py-4 mt-auto" style="background-color: #280336;">
        <div class="container">
            <div class="row align-items-center">
                <!-- Logo + texto -->
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <img src="~/Imagenes/Logo NeoMarket.png" alt="Logo" width="90" class="me-2">
                    © Derechos reservados - 2025
                </div>
                <!-- Redes -->
                <div class="col-md-6">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3">
                        <a href="https://www.youtube.com/watch?v=4KoU144az18" target="_blank">
                            <img src="~/Imagenes/Facebook_logo_(square).png" alt="YouTube" width="50">
                        </a>
                        <a href="https://www.instagram.com/_filosofarte?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank">
                            <img src="~/Imagenes/Instagram_icon.png" alt="Instagram" width="35">
                        </a>
                        <a href="#" target="_blank">
                            <img src="~/Imagenes/Gmail_icon_(2020).svg.png" alt="Gmail" width="40">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    </body>

<!-- Esto lo saque de la web, supuestamente, una solucion rapida a un problema que tenia-->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tabla = '@Model?.tablaSeleccionada';
            if (tabla && tabla !== '...') {
                var modal = new bootstrap.Modal(documen`t.getElementById('tablaModal'));
                modal.show();
            }
        });
    </script>
}
